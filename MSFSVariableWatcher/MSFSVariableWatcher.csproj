<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>MSFSVariableWatcher.Program</StartupObject>
    <Version>0.3.0</Version>
    <Product>MSFS Variable Watcher</Product>
    <Authors>Clamb94</Authors>
    <Company>Clamb94</Company>
    <Description>Local web UI to inspect and write MSFS LVARs via FSUIPC.</Description>
    <RepositoryUrl>https://github.com/Clamb94/MSFSVariableWatcher</RepositoryUrl>
    <!-- Native FSUIPC_WAPID.dll is P/Invoked by name, so it must sit next to the exe
         (not embedded in the single file). The <None> item below copies it to output/publish.
         Standalone (self-contained, no .NET runtime on target) is set via publish flags in CI. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FSUIPCClientDLL" Version="3.3.16" />
  </ItemGroup>

  <ItemGroup>
    <!-- K: event catalogue generated by tools/gen-kevents from the MSFS 2020 + 2024 SDK docs.
         Embedded so it survives a single-file publish. -->
    <EmbeddedResource Include="Data\KEvents.json" />
  </ItemGroup>

  <ItemGroup>
    <None Update="FSUIPC_WAPID.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
